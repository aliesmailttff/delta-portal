rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasRole(roles) {
      return signedIn() && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role in roles;
    }
    function isAdmin()    { return hasRole(['admin']); }
    function isFinance()  { return hasRole(['admin','finance']); }
    function isAcademic() { return hasRole(['admin','academic']); }
    function defaultPermission(role, area) {
      return (role == 'finance' && area in ['students','payments','accounts','logs','chat'])
        || (role == 'academic' && area in ['students','results','exams','library','attendance','schedule','requests','courses','news','chat']);
    }
    function hasPermission(area) {
      return signedIn() && exists(userPath(request.auth.uid))
        && (get(userPath(request.auth.uid)).data.role == 'admin'
          || (get(userPath(request.auth.uid)).data.role in ['finance','academic']
            && (get(userPath(request.auth.uid)).data.get('permissions', null) == null
              ? defaultPermission(get(userPath(request.auth.uid)).data.role, area)
              : (get(userPath(request.auth.uid)).data.permissions is list
                && area in get(userPath(request.auth.uid)).data.permissions))));
    }
    function isStaff()    { return hasRole(['admin','finance','academic']); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function siteIsOpen() {
      return !exists(/databases/$(database)/documents/settings/site_status)
        || get(/databases/$(database)/documents/settings/site_status).data.get('maintenanceMode', false) != true;
    }
    function isPortalStudent() { return hasRole(['student']) && siteIsOpen(); }
    function canUsePortal() { return isStaff() || isPortalStudent(); }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if (isAdmin() && request.resource.data.role in ['student','finance','academic'])
                    || (isAcademic() && hasPermission('students') && request.resource.data.role == 'student');
      allow update: if (isAdmin() && resource.data.role != 'admin' && request.resource.data.role != 'admin')
                    // المستخدم يلغي علامة "غيّر كلمة المرور" فقط
                    || (isOwner(uid) && changedKeys().hasOnly(['mustChangePassword'])
                        && request.resource.data.mustChangePassword == false);
      allow delete: if (isAdmin() && resource.data.role != 'admin')
                    || (isAcademic() && hasPermission('students') && resource.data.role == 'student');
    }

    match /students/{uid} {
      allow read: if (isOwner(uid) && isPortalStudent()) || hasPermission('students') || hasPermission('payments');
      allow create, delete: if isAcademic() && hasPermission('students');
      // الطالب لا يعدّل ملفه إطلاقاً. المالي يحدّث paidAmount فقط (اعتماد الإيصال)
      allow update: if (isAcademic() && hasPermission('students')) || (isFinance() && hasPermission('payments') && changedKeys().hasOnly(['paidAmount']));
    }

    match /results/{id} {
      allow read: if hasPermission('results') || (isPortalStudent() && resource.data.studentUid == request.auth.uid);
      allow write: if hasPermission('results');
    }

    match /exams/{id}   { allow read: if isPortalStudent() || hasPermission('exams'); allow write: if hasPermission('exams'); }
    match /news/{id}    { allow read: if isPortalStudent() || hasPermission('news'); allow write: if hasPermission('news'); }
    match /library/{id} { allow read: if isPortalStudent() || hasPermission('library'); allow write: if hasPermission('library'); }

    match /payments/{id} {
      allow read: if hasPermission('payments') || (isPortalStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isPortalStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'قيد المراجعة'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= get(/databases/$(database)/documents/students/$(request.auth.uid)).data.totalFees
        && !(exists(/databases/$(database)/documents/settings/payment_accounts)
             && get(/databases/$(database)/documents/settings/payment_accounts).data.get('maintenanceMode', false) == true);
      allow update: if isFinance() && hasPermission('payments')
        && changedKeys().hasOnly(['status','approvedBy','approvedAt','rejectReason']);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      // كود الحضور السري (PIN) لا يقرأه إلا الموظفون، والتحقق منه يتم هنا في القواعد
      allow read: if docId == 'site_status' || (isPortalStudent() && docId != 'active_attendance')
        || (docId == 'payment_accounts' && hasPermission('accounts'))
        || (docId in ['attendance_public','active_attendance'] && hasPermission('attendance'))
        || (docId == 'registration' && hasPermission('courses'));
      allow write: if (docId == 'site_status' && isAdmin())
                   || (docId == 'payment_accounts' && hasPermission('accounts'))
                   || ((docId == 'active_attendance' || docId == 'attendance_public') && hasPermission('attendance'))
                   || (docId == 'registration' && hasPermission('courses'));
    }

    match /attendance_qr_sessions/{sessionId} { allow read, write: if false; }
    match /attendance_qr_tokens/{tokenHash} { allow read, write: if false; }

    match /attendance/{id} {
      allow read: if hasPermission('attendance') || (isPortalStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isPortalStudent()
        && request.resource.data.studentUid == request.auth.uid
        && id == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.sessionId == get(/databases/$(database)/documents/settings/attendance_public).data.sessionId
        && request.time.toMillis() < get(/databases/$(database)/documents/settings/attendance_public).data.expiresAt
        && request.resource.data.pin == get(/databases/$(database)/documents/settings/active_attendance).data.code;
      allow update: if false;
      allow delete: if hasPermission('attendance');
    }

    match /audit_logs/{id} {
      allow read: if hasPermission('logs');
      allow create: if canUsePortal() && request.resource.data.adminEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    match /chats/{studentUid}/messages/{msgId} {
      allow read: if (isOwner(studentUid) && isPortalStudent()) || hasPermission('chat');
      allow create: if ((isOwner(studentUid) && isPortalStudent()) || hasPermission('chat'))
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /courses/{id} { allow read: if isPortalStudent() || hasPermission('courses'); allow write: if hasPermission('courses'); }

    match /registrations/{id} {
      allow read: if hasPermission('courses') || (isPortalStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isPortalStudent()
        && request.resource.data.studentUid == request.auth.uid
        && id.matches(request.auth.uid + '_.*')
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && request.resource.data.credits == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.credits
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.level
           == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.level
        && get(/databases/$(database)/documents/settings/registration).data.open == true
        && request.resource.data.year == get(/databases/$(database)/documents/settings/registration).data.year
        && request.resource.data.semester == get(/databases/$(database)/documents/settings/registration).data.semester;
      allow update: if false;
      allow delete: if hasPermission('courses')
        || (isPortalStudent() && resource.data.studentUid == request.auth.uid && get(/databases/$(database)/documents/settings/registration).data.open == true);
    }

    match /schedule/{id} { allow read: if isPortalStudent() || hasPermission('schedule'); allow write: if hasPermission('schedule'); }

    match /requests/{id} {
      allow read: if hasPermission('requests') || (isPortalStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isPortalStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'قيد المراجعة'
        && request.resource.data.type in ['تظلم من نتيجة','شهادة قيد','إفادة التحاق','كشف درجات رسمي','أخرى']
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000;
      allow update: if hasPermission('requests') && changedKeys().hasOnly(['status','reply','handledBy','handledAt']);
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
